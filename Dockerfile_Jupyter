FROM nvcr.io/nvidia/pytorch:24.10-py3
# Install system packages
RUN apt-get update -yq &&\
    ln -fs /usr/share/zoneinfo/America/Los_Angeles /etc/localtime &&\
    DEBIAN_FRONTEND=noninteractive apt-get install -y tzdata &&\
    dpkg-reconfigure --frontend noninteractive tzdata &&\
    apt-get install -yq nodejs curl zsh zip git build-essential python3.10 python3.10-venv python3.10-dev python3-pip libgl1 libglib2.0-0 autoconf autopoint libtool &&\
    bash -c "$(curl -sL https://deb.nodesource.com/setup_18.x)"
# Install torch & jupyter & requirements
COPY requirements.txt .
RUN python3.10 -m venv venv &&\
    . venv/bin/activate &&\
    pip3 install --upgrade pip&&\
    pip3 install git+https://github.com/MSeal/cython_hunspell.git@2.0.3 &&\
    pip3 install flask redis orderedset xgboost scikit-learn requests cython &&\
    pip3 install jupyter-resource-usage jupyterlab-git python-magic pyarrow elasticsearch deepdiff ipywidgets &&\
    pip3 install --no-cache-dir -r requirements.txt
# set up workspace
WORKDIR /workspace/
RUN mkdir ~/.jupyter &&\
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" &&\
    git clone https://github.com/zsh-users/zsh-autosuggestions ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions
# Cleanup, setup workspace and move the .zshrc
RUN apt-get autoremove -yq && apt-get autoclean -y && apt-get clean -y &&\
    rm -rf requirements.txt /var/lib/apt/lists/* /tmp/* /var/tmp/* &&\
    mv ~/.zshrc /workspace/.zshrc && \
    ln -s /workspace/.zshrc ~/.zshrc

RUN mkdir -p /workspace/
SHELL ["/bin/zsh", "-c"]
EXPOSE 8888
# CMD jupyter notebook  --ResourceUseDisplay.track_cpu_percent=True --no-browser --port 8888 $CERTFILE_OPTION --ip='*' --NotebookApp.token='' --NotebookApp.password='' --allow-root
CMD . /venv/bin/activate && jupyter lab --ServerApp.open_browser=False --ExtensionApp.open_browser=False --LabApp.open_browser=False --ContentsManager.allow_hidden=True --port 8888 --ip='*' --NotebookApp.token='' --NotebookApp.password='' --allow-root
